                    <ScriptInputNumber propertyValue="5" name="baseCost"/>
                    <ScriptInputNumber propertyValue="2.8" name="growth"/>
                    <ScriptInputNumber propertyValue="1" name="classScoped"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:190" listenerTypeValue="click" name="BuyDockSpeed" id="0:196">
