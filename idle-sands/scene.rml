                        <TextValueRun styleId="0:183" text="Steel Seeker &#215;" name="BuySteelSeekerPrefix"/>
                        <TextValueRun styleId="0:183" text="0" name="BuySteelSeekerCount">
                            <DataBindContext sourcePathIds="0:200-0:280" propertyKey="268" converterId="0:301"/>
                        </TextValueRun>
                    </Text>

                    <Text name="BuySteelSeekerCost" id="0:184">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="BuySteelSeekerCost Layout"/>
                        <TextStylePaint fontSize="14" fontAssetId="0:300" name="BuySteelSeekerCostStyle" id="0:185">
                            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                        </TextStylePaint>
                        <TextValueRun styleId="0:185" text="220" name="BuySteelSeekerCostRun">
                            <DataBindContext sourcePathIds="0:200-0:282" propertyKey="268"/>
                        </TextValueRun>
                    </Text>
                </LayoutComponent>
                </LayoutComponent>

                <LayoutComponent width="200" height="56" styleId="0:61" name="SellButton" id="0:60">
                    <LayoutComponentStyle layoutWidthScaleType="fixed" layoutHeightScaleType="fixed"
                                          layoutAlignmentType="center"
                                          cornerRadiusTL="12" cornerRadiusTR="12" cornerRadiusBL="12" cornerRadiusBR="12"
                                          name="SellButton Style" id="0:61"/>
                    <DataBindContext sourcePathIds="0:200-0:239" propertyKey="18"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFE8785A" name="C">
                            <DataBindContext sourcePathIds="0:100-0:106" propertyKey="37"/>
                        </SolidColor>
                    </Fill>

                    <Text name="SellLabel" id="0:62">
                        <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="SellLabel Layout"/>
                        <TextStylePaint fontSize="20" fontAssetId="0:300" name="SellStyle" id="0:63">
                            <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                        </TextStylePaint>
                        <TextValueRun styleId="0:63" text="Sell All ($" name="SellPrefixRun"/>
                        <TextValueRun styleId="0:63" text="0" name="SellValueRun">
                            <DataBindContext sourcePathIds="0:200-0:238" propertyKey="268" converterId="0:301"/>
                        </TextValueRun>
                        <TextValueRun styleId="0:63" text=")" name="SellSuffixRun"/>
                    </Text>
                </LayoutComponent>
            </LayoutComponent>
        </LayoutComponent>

        <LayoutComponent width="1280" height="100" styleId="0:51" name="InventoryStrip" id="0:50">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fixed"
                                  flexDirectionValue="row" layoutAlignmentType="centerLeft"
                                  gapHorizontal="8" gapHorizontalUnitsValue="points"
                                  paddingLeft="16" paddingLeftUnitsValue="points"
                                  paddingRight="16" paddingRightUnitsValue="points"
                                  name="InventoryStrip Style" id="0:51"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFD9C9A3" name="C">
                    <DataBindContext sourcePathIds="0:100-0:105" propertyKey="37"/>
                </SolidColor>
            </Fill>

            <Text name="StoredSummary" id="0:53">
                <LayoutParticipant layoutWidthScaleType="hug" layoutHeightScaleType="hug" name="StoredSummary Layout"/>
                <TextStylePaint fontSize="18" fontAssetId="0:300" name="StoredSummaryStyle" id="0:54">
                    <Fill name="Fill"><SolidColor colorValue="FF1D2B27" name="C"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:54" text="Stored: " name="StoredSummaryPrefix"/>
                <TextValueRun styleId="0:54" text="0" name="StoredSummaryCount">
                    <DataBindContext sourcePathIds="0:200-0:255" propertyKey="268" converterId="0:301"/>
                </TextValueRun>
                <TextValueRun styleId="0:54" text=" ($" name="StoredSummaryMid"/>
                <TextValueRun styleId="0:54" text="0" name="StoredSummaryValue">
                    <DataBindContext sourcePathIds="0:200-0:238" propertyKey="268" converterId="0:301"/>
                </TextValueRun>
                <TextValueRun styleId="0:54" text=")" name="StoredSummarySuffix"/>
            </Text>
        </LayoutComponent>

        <StateMachine name="Main" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="0" y="-120"/>
                <ExitState x="200" y="-120"/>
                <EntryState x="-200" y="-120"/>
            </StateMachineLayer>

            <StateMachineListenerSingle targetId="0:802" listenerTypeValue="click" name="SelectBeachCrew" id="0:818">
                <ScriptedListenerAction scriptAssetId="0:317" id="0:819">
                    <ScriptInputString propertyValue="beachCrew" name="className"/>
                    <ScriptInputNumber propertyValue="0" name="isRobotsTab"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:806" listenerTypeValue="click" name="SelectSteelSeeker" id="0:820">
                <ScriptedListenerAction scriptAssetId="0:317" id="0:821">
                    <ScriptInputString propertyValue="steelSeeker" name="className"/>
                    <ScriptInputNumber propertyValue="0" name="isRobotsTab"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:810" listenerTypeValue="click" name="SelectRobotsTab" id="0:822">
