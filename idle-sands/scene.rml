<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="1280" height="720" name="IdleSands" id="0:2">
        <LayoutComponentStyle flexDirectionValue="column" name="Artboard Style" id="0:5"/>

        <LayoutComponent width="1280" height="64" styleId="0:11" name="TopBar" id="0:10">
