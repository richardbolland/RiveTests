                    <ScriptInputString propertyValue="" name="className"/>
                    <ScriptInputNumber propertyValue="1" name="isRobotsTab"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:60" listenerTypeValue="click" name="SellAll" id="0:64">
                <ScriptedListenerAction scriptAssetId="0:311" id="0:65"/>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:70" listenerTypeValue="click" name="BuyItemsPerDig" id="0:76">
                <ScriptedListenerAction scriptAssetId="0:312" id="0:77">
                    <ScriptInputString propertyValue="itemsPerDig" name="statName"/>
                    <ScriptInputNumber propertyValue="1" name="step"/>
                    <ScriptInputNumber propertyValue="1" name="minValue"/>
                    <ScriptInputNumber propertyValue="6" name="maxValue"/>
                    <ScriptInputNumber propertyValue="5" name="baseCost"/>
                    <ScriptInputNumber propertyValue="2.8" name="growth"/>
                    <ScriptInputNumber propertyValue="1" name="classScoped"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:80" listenerTypeValue="click" name="BuyDigSpeed" id="0:86">
                <ScriptedListenerAction scriptAssetId="0:312" id="0:87">
                    <ScriptInputString propertyValue="digSpeedSeconds" name="statName"/>
                    <ScriptInputNumber propertyValue="-11" name="step"/>
                    <ScriptInputNumber propertyValue="5" name="minValue"/>
                    <ScriptInputNumber propertyValue="60" name="maxValue"/>
                    <ScriptInputNumber propertyValue="5" name="baseCost"/>
                    <ScriptInputNumber propertyValue="2.8" name="growth"/>
                    <ScriptInputNumber propertyValue="1" name="classScoped"/>
                </ScriptedListenerAction>
            </StateMachineListenerSingle>

            <StateMachineListenerSingle targetId="0:150" listenerTypeValue="click" name="BuyElbowGrease" id="0:156">
